# Neon connection string (use the pooled endpoint, with sslmode=require).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs the session cookie. Any random string of 32+ characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Your admin password, bcrypt-hashed.
# Generate with: npm run hash-password "your password"
ADMIN_PASSWORD_HASH=

# Plain-text alternative to ADMIN_PASSWORD_HASH, for local development only.
# ADMIN_PASSWORD=

# Display name on your messages. Defaults to "Admin".
# ADMIN_NAME=
